# Production image (Week 12, Render). The dev image (Dockerfile) installs test tools and
# is run with --reload by docker compose; this one has neither, and does not run as root.
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

COPY . .
RUN useradd --create-home --uid 10001 app && chown -R app /app
USER app

EXPOSE 8000
# Migrations first (Render's free plan has no pre-deploy step), then the API on the port
# Render gives in $PORT. --proxy-headers: Render's proxy says the browser used HTTPS.
CMD ["sh", "-c", "alembic upgrade head && exec uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-8000} --proxy-headers --forwarded-allow-ips='*'"]
