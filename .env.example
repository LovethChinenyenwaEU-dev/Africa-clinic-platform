# Copy to .env and adjust. Never commit .env.
POSTGRES_USER=clinic
POSTGRES_PASSWORD=clinic
POSTGRES_DB=clinic

# Hostnames below are Docker Compose service names (db, redis).
# To run the API outside Docker, replace them with localhost.
DATABASE_URL=postgresql+psycopg://clinic:clinic@db:5432/clinic
REDIS_URL=redis://redis:6379/0

ENVIRONMENT=development
SECRET_KEY=dev-only-secret-change-me-before-real-use-0123456789
CORS_ORIGINS=http://localhost:3000

# Reminders. "none" sends nothing (safe for development).
SMS_PROVIDER=none
REMINDER_INTERVAL_SECONDS=30

# Teleconsult video. "jitsi" makes private Jitsi Meet rooms; "none" turns video off (chat only).
# meet.jit.si is fine for a pilot; for live use, point this at the clinic's own Jitsi server.
VIDEO_PROVIDER=jitsi
JITSI_BASE_URL=https://meet.jit.si

# Web app: exact extra addresses trusted to sign in and save, comma separated.
# Only needed behind a proxy that hides the real address, such as GitHub Codespaces:
# TRUSTED_ORIGINS=https://<your-codespace-name>-3000.app.github.dev
TRUSTED_ORIGINS=
